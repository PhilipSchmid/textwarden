{
  "manifest_version": 3,
  "name": "TextWarden Browser Extension (Preview)",
  "version": "0.5.2.38",
  "description": "Check the current editor locally with the TextWarden Mac app. Use the toolbar menu to check the current page.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "TextWarden",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar.png",
      "32": "toolbar.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "127",
  "version_name": "0.5.2",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@textwarden.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "websiteActivity",
          "browsingActivity",
          "personalCommunications"
        ]
      }
    }
  }
}
